rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document
    match /users/{userId} {
      allow read, write: if true;
    }

    // Notes collection
    match /notes/{noteId} {
      allow read, write: if true;
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow read, write: if true;
    }

    // Daily Goals collection
    match /daily_goals/{goalId} {
      allow read, write: if true;
    }

    // Group Workspaces collection
    match /group_workspaces/{workspaceId} {
      allow read, write: if true;
    }

    // Group Members collection
    match /group_members/{memberId} {
      allow read, write: if true;
    }

    // Group Tasks collection
    match /group_tasks/{groupTaskId} {
      allow read, write: if true;
    }

    // Group Notes collection
    match /group_notes/{groupNoteId} {
      allow read, write: if true;
    }

    // Group Chat collection
    match /group_chat/{chatId} {
      allow read, write: if true;
    }

    // Group Activities collection
    match /group_activities/{activityId} {
      allow read, write: if true;
    }

    // Group Calls collection for real-time call ringing & signaling
    match /group_calls/{callId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Transactions collection for expenses & income
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Budgets collection for category limits
    match /budgets/{budgetId} {
      allow read, write: if true;
    }
  }
}

